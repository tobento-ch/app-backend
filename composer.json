{
    "name": "tobento/app-backend",
    "version": "2.0.1",
    "type": "library",
    "description": "App backend.",
    "keywords": [
        "tobento",
        "package",
        "app",
        "backend"
	],
    "homepage": "https://www.tobento.ch",
    "license": "MIT",
    "authors": [
        {
            "name": "Tobias Strub",
            "email": "info@tobento.ch",
            "homepage": "https://www.tobento.ch"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": ">=8.4",
        "tobento/app": "^2.0",
        "tobento/apps": "^2.0",
        "tobento/app-cache": "^2.0",
        "tobento/app-card": "^2.0",
        "tobento/app-crud": "^2.0",
        "tobento/app-media": "^2.0",
        "tobento/app-search": "^2.0",
        "tobento/app-user-web": "^2.0",
        "tobento/js-editor": "^1.0",
        "tobento/css-modal": "^1.0"
    },  
    "require-dev": {
        "phpunit/phpunit": "^12.3",
        "vimeo/psalm": "^6.13",
        "tobento/app-profiler": "^2.0",
        "tobento/app-testing": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Tobento\\App\\Backend\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tobento\\App\\Backend\\Test\\": "tests"
        }
    },
    "scripts": {
        "test": "phpunit --testdox --colors=always",
        "psalm": "vendor/bin/psalm"
    }
}